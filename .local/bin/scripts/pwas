#!/bin/sh
# A script to list and launch the installed chromium PWAs through dmenu
pwaCount=`ls ~/.local/share/applications/brave-* | wc -l`
pwaToLaunch=`ls ~/.local/share/applications/brave-*  | dmenu -l $pwaCount`

the_command=$(grep Exec= $pwaToLaunch | cut -d= -f2-)

echo "$the_command --new-window" | sh
